# Copiez ce fichier en .env (local). Sur Vercel, ces variables se règlent
# dans Settings → Environment Variables.

# Base de données PostgreSQL (Neon, via l'intégration Vercel), comme TASKS.
# Le plus simple : `vercel env pull .env`.
#  - DATABASE_URL : chaîne "pooled" (via PgBouncer) — utilisée par l'application ;
#  - DATABASE_URL_UNPOOLED : chaîne "directe" — utilisée par les migrations.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# Clé secrète qui signe les jetons de connexion (sessions, liens
# d'invitation). Valeur aléatoire longue, ex. : openssl rand -base64 32
# Utilisez une valeur DIFFÉRENTE en production.
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# Adresse publique de l'application : liens de désinscription et pixel
# d'ouverture des e-mails. Sur Vercel, facultative (domaine de production
# par défaut). En local, à mettre dans .env.local.
APP_URL="http://localhost:3000"

# Traitement de la file d'envoi.
#  - En local : "1" (dans .env.local) = l'application traite elle-même la
#    file toutes les 10 secondes (rien d'autre à lancer).
#  - Sur Vercel : ne pas définir ; la file est traitée par /api/cron/send-queue.
QUEUE_INTERNAL="1"
# Protège /api/cron/send-queue (Vercel envoie "Authorization: Bearer
# <CRON_SECRET>" automatiquement). Laissée vide en local, la vérification
# est ignorée.
CRON_SECRET=""

# Fournisseurs : "simulation" tant que les fournisseurs ne sont pas choisis.
SMS_PROVIDER="simulation"
EMAIL_PROVIDER="simulation"   # ou "smtp"

# SMTP (si EMAIL_PROVIDER="smtp")
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Campagnes <no-reply@exemple.ga>"

# Secret partagé pour les webhooks des fournisseurs (en-tête x-webhook-secret).
WEBHOOK_SECRET="change-moi"

# Notifications push (PWA) — même principe que TASKS (lib/push.ts).
# Générer une paire une seule fois : npx web-push generate-vapid-keys
# Sans elles, le push est ignoré ; la cloche dans l'application fonctionne.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.ga"
